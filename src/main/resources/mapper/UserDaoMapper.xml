<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bigdata.dao.UserDao">
    <select id="selectById" parameterType="int" resultMap="userMap">
        SELECT *
        FROM tb_user
        WHERE u_id = #{id}
    </select>

    <select id="selectByUsername" parameterType="String" resultMap="userMap">
        SELECT *
        FROM tb_user
        WHERE u_name = #{username}
    </select>

    <select id="selectByUsernameAndPwd" resultMap="userMap">
        SELECT *
        FROM tb_user
        WHERE u_name = #{username} AND u_pwd = #{pwd}
    </select>

    <select id="selectList" resultMap="userMap">
        SELECT *
        FROM tb_user
    </select>

    <select id="selectListByCondition" resultMap="userMap">
        SELECT *
        FROM tb_user
        <where>
            <if test="id != null"> <!-- WHERE，会自动忽略前后缀（如：and | or） -->
                and id = #{id}
            </if>

            <if test="username != null">
                and u_name = #{username}
            </if>

            <if test="gender != null">
                and u_gender = #{gender}
            </if>

            <if test="password != null">
                and u_pwd = #{password}
            </if>

        </where>
    </select>

    <delete id="deleteById" parameterType="int">
        DELETE
        FROM tb_user
        WHERE u_id = #{id}
    </delete>

    <insert id="insertOne">
        INSERT INTO tb_user(u_name, u_pwd, u_gender, reg_time)
        VALUES (#{username}, #{password}, #{gender}, #{regTime})
    </insert>

    <update id="updateOne">
        UPDATE tb_user
        SET u_name=#{username},
            u_pwd=#{password},
            u_gender=#{gender}
        WHERE u_id=#{id}
    </update>

    <!--定义resultMap标签-->
    <resultMap id="userMap" type="User">
        <!--关联主键与列名-->
        <id property="id" column="u_id"/>
        <!--关联属性与列名-->
        <result property="username" column="u_name"/>
        <result property="password" column="u_pwd"/>
        <result property="gender" column="u_gender"/>
        <result property="regTime" column="reg_time"/>
    </resultMap>


</mapper>